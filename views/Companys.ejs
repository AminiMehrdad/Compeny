<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <title>Copenys</title>
</head>

<body>
    <%- include('header'); %>
    <div class="container mt-4">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col"></th>
                    <th scope="col">Compeny Name</th>
                    <th scope="col">Regester Id</th>
                    <th scope="col">City</th>
                    <th scope="col">State</th>
                    <th scope="col">Create At</th>
                    <th scope="col">Phone</th>
                    <th scope="col"></th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody class="table-group-divider">
                <% compenys.map((value, index) => {%>
                    <tr>
                        <th scope="row"><%= index+1 %></th>
                        <td><%= value.name %></td>
                        <td><%= value.regester_id %></td>
                        <td><%= value.city %></td>
                        <td><%= value.state %></td>
                        <td><%= value.createat %></td>
                        <td><%= value.phone %></td> 
                        <td><button type="button" class="btn btn-link"><a href=<%= `http://localhost:5000/users/${value._id}` %>>details</a></button></td>
                        <!-- <a href= "/compenys/"+ value._id >details</a> -->
                        <td>
                            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target=<%= "#deleat"+`${index+1}` %>>Delete</button>
                            <button type="button" class="btn btn-info"  data-bs-toggle="modal" data-bs-target=<%= "#update"+`${index+1}` %>>Update</button>
                        </td>
                    </tr>    
               <% }) %>
            </tbody>
        </table>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#create">Add Compeny</button>

    </div>



   <!-- Modal Create-->
    <div class="modal fade" id="create" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="createLabel" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h1 class="modal-title fs-5" id="createLabel">Create Compeny</h1>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                      <label for="nameInput" class="form-label">*Compeny Name</label>
                      <input type="text" class="form-control" id="nameInput" name="name">
                    </div>
                    <div class="mb-3">
                      <label for="regesterInpu" class="form-label">Regester ID</label>
                      <input type="text" class="form-control" id="regesterInpu" name="regester_id">
                    </div>
                    <div class="mb-3">
                        <label for="cityInpu" class="form-label">*City</label>
                        <input type="text" class="form-control" id="cityInpu" name="city">
                    </div>
                    <div class="mb-3">
                        <label for="stateInpu" class="form-label">*State</label>
                      <input type="text" class="form-control" id="stateInpu" name="state">
                      </div>
                      <div class="mb-3">
                        <label for="createInpu" class="form-label">Date Compeny Create</label>
                      <input type="date" class="form-control" id="createInpu" name="createat">
                      </div>
                      <div class="mb-3">
                        <label for="phoneInpu" class="form-label">*Compeny Phone Number</label>
                        <input type="text" class="form-control" id="phoneInpu" name="phone">
                      </div>
                  </form>
            </div>
            <div class="alert alert-danger mx-3 d-none" role="alert" id="Alert">
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
              <button type="button" class="btn btn-primary"  onclick="SubminForm()">Create</button>
            </div>        
          </div>
          
        </div>
    </div>

    <!-- Modal Deleat-->
    <% compenys.map((value, index) => {%> 
    <div class="modal fade" id=<%= "deleat"+`${index+1}` %> tabindex="-1" aria-labelledby="deleatLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="deleatLabel">Deleat Compeny</h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <P>
              are you shore to deleat <b><%= value.name %></b> from data set?
            </P>
            <input type="text" class="d-none" value=<%= value._id %> id="user">
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="button" class="btn btn-danger" onclick="delete_compeny()">Yes</button>
          </div>
        </div>
      </div>
    </div>
    <% }) %>

    <!-- Modal Update-->
    <% compenys.map((value, index) => {%> 
      <div class="modal fade" id=<%= "update"+`${index+1}` %>  data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="updateLabel" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h1 class="modal-title fs-5" id="updateLabel">Update Compeny</h1>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                      <label for="nameInput" class="form-label">*Compeny Name</label>
                      <input type="text" class="form-control" id="nameInputU" value=<%= value.name%>>
                    </div>
                    <div class="mb-3">
                      <label for="regesterInpu" class="form-label">Regester ID</label>
                      <input type="text" class="form-control" id="regesterInputU" value=<%= value.regester_id%>>
                    </div>
                    <div class="mb-3">
                        <label for="cityInpu" class="form-label">*City</label>
                        <input type="text" class="form-control" id="cityInputU" value=<%= value.city%>>
                    </div>
                    <div class="mb-3">
                        <label for="stateInpu" class="form-label">*State</label>
                      <input type="text" class="form-control" id="stateInputU" value=<%= value.state%>>
                      </div>
                      <div class="mb-3">
                        <label for="createInpu" class="form-label">Date Compeny Create</label>
                      <input type="date" class="form-control" id="createInputU" value=<%= value.createat%>>
                      </div>
                      <div class="mb-3">
                        <label for="phoneInpu" class="form-label">*Compeny Phone Number</label>
                        <input type="text" class="form-control" id="phoneInputU" value=<%= value.phone%>>
                      </div>
                  </form>
            </div>
            <div class="alert alert-danger mx-3 d-none" role="alert" id="AlertU">
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
              <button type="button" class="btn btn-info"  onclick="Update_compeny()">Update</button>
            </div>        
          </div>
          
        </div>
      </div>
      <% }) %>
    
  

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="/javascripts/copenyRequest.js"></script>
</body>

</html>